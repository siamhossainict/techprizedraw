@{
    ViewData["Title"] = "Campaign Sold Out";
}

<div class="container py-5 text-center" style="max-width: 650px;">
    <div class="card-tech p-5">
        <div style="font-size: 3.5rem; margin-bottom: 1rem;">🔒</div>
        <span class="badge bg-danger px-3 py-2 mb-3" style="font-size: 0.9rem; text-transform: uppercase;">
            CAPACITY REACHED
        </span>
        <h1 class="text-white mb-3" style="font-size: 2.2rem;">All 5,000 Tickets Reserved / Sold</h1>
        <p class="text-secondary mb-4" style="font-size: 1rem;">
            The TECH Prize Draw has reached its maximum inventory limit of 5,000 tickets. In accordance with strict platform policy, no additional entries will be accepted.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a href="/" class="btn-tech-outline">Homepage</a>
            <a href="/winners" class="btn-tech-gold">View Winners Portal</a>
        </div>
    </div>
</div>
