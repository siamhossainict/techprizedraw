@model TechPrizeDraw.Models.ViewModels.ContactViewModel
@{
    ViewData["Title"] = "Contact Support & Inquiries";
}

<div class="container py-5">
    <!-- Header Banner -->
    <div class="text-center mb-5">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" style="background: rgba(0, 210, 255, 0.1); border: 1px solid rgba(0, 210, 255, 0.3); font-size: 0.85rem; color: #00D2FF; font-weight: 600;">
            <span>💬</span> 24/7 SUPPORT & VERIFICATION DESK
        </div>
        <h1 class="display-5 fw-bold text-white mb-3">Get in Touch With Our Team</h1>
        <p class="text-secondary mx-auto" style="max-width: 650px; font-size: 1.05rem;">
            Need help with your ticket voucher, MFS payment verification, or have questions regarding the upcoming prize draw? Reach out directly via WhatsApp, email, or send us a query below.
        </p>
    </div>

    <!-- Quick Direct Contact Channels Grid -->
    <div class="row g-4 mb-5">
        <!-- 1. Direct WhatsApp Card -->
        <div class="col-md-6">
            <div class="card-tech h-100 p-4 p-lg-5 d-flex flex-column justify-content-between position-relative overflow-hidden" style="border: 1px solid rgba(37, 211, 102, 0.35); background: linear-gradient(165deg, rgba(14, 26, 61, 0.95) 0%, rgba(37, 211, 102, 0.08) 100%);">
                <div class="position-absolute top-0 end-0 p-3" style="opacity: 0.12; font-size: 5rem; line-height: 1; pointer-events: none;">
                    💬
                </div>
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background: rgba(37, 211, 102, 0.15); border: 1px solid #25D366; font-size: 1.6rem; color: #25D366;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.707 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/>
                            </svg>
                        </div>
                        <span class="badge" style="background: rgba(37, 211, 102, 0.2); color: #25D366; border: 1px solid rgba(37, 211, 102, 0.4); font-size: 0.75rem;">
                            ● Online / Instant Reply
                        </span>
                    </div>
                    <h3 class="h4 text-white fw-bold mb-2">WhatsApp Support</h3>
                    <p class="text-secondary mb-4" style="font-size: 0.95rem;">
                        Connect directly with our support team on WhatsApp for instantaneous assistance regarding ticket status, payment verification, and rapid answers.
                    </p>
                </div>
                <div>
                    <a href="https://wa.me/8801879732435?text=Hello%20TECH%20Prize%20Draw%20Support%2C%20I%20have%20an%20inquiry%20regarding%3A" target="_blank" rel="noopener noreferrer" class="btn w-100 py-3 fw-semibold d-flex align-items-center justify-content-center gap-2" style="background: #25D366; color: #060B18; border-radius: 8px; font-size: 1rem; box-shadow: 0 4px 15px rgba(37, 211, 102, 0.35);">
                        <span>Chat With Us on WhatsApp</span> →
                    </a>
                </div>
            </div>
        </div>

        <!-- 2. Official Email Card -->
        <div class="col-md-6">
            <div class="card-tech h-100 p-4 p-lg-5 d-flex flex-column justify-content-between position-relative overflow-hidden" style="border: 1px solid rgba(0, 210, 255, 0.35); background: linear-gradient(165deg, rgba(14, 26, 61, 0.95) 0%, rgba(0, 210, 255, 0.08) 100%);">
                <div class="position-absolute top-0 end-0 p-3" style="opacity: 0.12; font-size: 5rem; line-height: 1; pointer-events: none;">
                    ✉️
                </div>
                <div>
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background: rgba(0, 210, 255, 0.15); border: 1px solid #00D2FF; font-size: 1.6rem; color: #00D2FF;">
                            ✉️
                        </div>
                        <span class="badge" style="background: rgba(0, 210, 255, 0.2); color: #00D2FF; border: 1px solid rgba(0, 210, 255, 0.4); font-size: 0.75rem;">
                            1–2 Hr Response
                        </span>
                    </div>
                    <h3 class="h4 text-white fw-bold mb-2">Email Desk</h3>
                    <p class="text-secondary mb-3" style="font-size: 0.95rem;">
                        Formal verification queries, proof of payment screenshots, official communication, and platform inquiries.
                    </p>
                    <div class="p-2 px-3 rounded mb-4" style="background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08);">
                        <small class="text-muted d-block" style="font-size: 0.75rem;">Official Support Email</small>
                        <strong class="text-white font-monospace" style="font-size: 1rem; word-break: break-all;">techprizedraw@inbox.eu</strong>
                    </div>
                </div>
                <div>
                    <a href="mailto:techprizedraw@inbox.eu?subject=TECH%20Prize%20Draw%20Query" class="btn btn-tech-outline w-100 py-3 fw-semibold d-flex align-items-center justify-content-center gap-2" style="font-size: 1rem;">
                        <span>Send an Email</span> ↗
                    </a>
                </div>
            </div>
        </div>
    </div>
    </div>

    <!-- Query Submission Form Section -->
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card-tech p-4 p-md-5" style="border: 1px solid rgba(0, 210, 255, 0.25); box-shadow: 0 15px 40px -10px rgba(0, 0, 0, 0.8), 0 0 25px rgba(0, 210, 255, 0.1);">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                    <div>
                        <h2 class="h3 text-white fw-bold mb-1">Submit a Support Inquiry</h2>
                        <p class="text-secondary mb-0" style="font-size: 0.9rem;">
                            Our verification operators independently check transaction records and will respond with ticket status details.
                        </p>
                    </div>
                    <span class="badge bg-dark border border-secondary text-info px-3 py-2" style="font-size: 0.8rem;">
                        Ticket / TrxID Priority
                    </span>
                </div>

                @if (TempData["ContactSuccess"] != null)
                {
                    <div class="alert alert-success d-flex align-items-center gap-3 p-3 mb-4 rounded-3" role="alert" style="background: rgba(16, 185, 129, 0.18); border: 1px solid #10B981; color: #10B981;">
                        <span style="font-size: 1.8rem; line-height: 1;">✓</span>
                        <div>
                            <strong class="d-block" style="font-size: 1rem;">Inquiry Received!</strong>
                            <span style="font-size: 0.9rem; color: #E2E8F0;">@TempData["ContactSuccess"]</span>
                        </div>
                    </div>
                }

                <form asp-controller="Home" asp-action="Contact" method="post" id="contactForm">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label-tech">Full Name <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control form-tech w-100" placeholder="e.g. Tanvir Ahmed" />
                            <span asp-validation-for="Name" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label-tech">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" type="email" class="form-control form-tech w-100" placeholder="name@example.com" />
                            <span asp-validation-for="Email" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label-tech">
                                Mobile Number <span class="text-muted" style="font-size: 0.75rem;">(WhatsApp Preferred)</span>
                            </label>
                            <input asp-for="Phone" class="form-control form-tech w-100" placeholder="01XXXXXXXXX" />
                            <span asp-validation-for="Phone" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ReferenceId" class="form-label-tech">
                                Ticket No. or TrxID <span class="text-muted" style="font-size: 0.75rem;">(Optional)</span>
                            </label>
                            <input asp-for="ReferenceId" class="form-control form-tech w-100 font-monospace" placeholder="e.g. TECH-0042 or 9X87AK3L2" />
                            <span asp-validation-for="ReferenceId" class="text-danger" style="font-size: 0.8rem;"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Category" class="form-label-tech">Inquiry Category <span class="text-danger">*</span></label>
                        <select asp-for="Category" class="form-select form-tech w-100">
                            <option value="Ticket Verification">Ticket Verification & Status</option>
                            <option value="Payment Confirmation">Payment Issue (bKash / Nagad TrxID)</option>
                            <option value="Voucher Resend">Voucher Resend Request</option>
                            <option value="Prize & Draw">Prize Showcase & Draw Date Queries</option>
                            <option value="Technical Support">Technical & Website Issue</option>
                            <option value="General Inquiry">General Inquiry / Other</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger" style="font-size: 0.8rem;"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Message" class="form-label-tech">Detailed Query <span class="text-danger">*</span></label>
                        <textarea asp-for="Message" rows="5" class="form-control form-tech w-100" placeholder="Please describe your question or issue in detail..."></textarea>
                        <span asp-validation-for="Message" class="text-danger" style="font-size: 0.8rem;"></span>
                    </div>

                    <div class="d-flex flex-column flex-sm-row align-items-center justify-content-between gap-3 pt-2">
                        <div class="d-flex align-items-center gap-2 text-secondary" style="font-size: 0.85rem;">
                            <span>🔒</span> Encrypted submission. Manual statement verification.
                        </div>

                        <button type="submit" class="btn-tech-gold px-4 py-2 fw-bold" style="min-width: 220px; font-size: 1rem;">
                            Submit Inquiry →
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Quick Help & FAQs Strip -->
    <div class="row g-4 mt-4 justify-content-center">
        <div class="col-md-4">
            <div class="p-3 rounded-3" style="background: rgba(14, 26, 61, 0.6); border: 1px solid var(--border-subtle);">
                <h4 class="h6 text-white mb-2">⚡ Instant WhatsApp Response</h4>
                <p class="text-secondary mb-0" style="font-size: 0.82rem;">
                    For faster resolution during business hours, connect directly with our support team on <a href="https://wa.me/8801879732435?text=Hello%20TECH%20Prize%20Draw%20Support" target="_blank" rel="noopener noreferrer" class="text-success text-decoration-underline fw-semibold">WhatsApp Chat</a>.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 rounded-3" style="background: rgba(14, 26, 61, 0.6); border: 1px solid var(--border-subtle);">
                <h4 class="h6 text-white mb-2">🔍 Ticket Verification</h4>
                <p class="text-secondary mb-0" style="font-size: 0.82rem;">
                    You can also look up any active ticket directly via our <a href="/ticket/verify" class="text-info text-decoration-underline">Public Ticket Verification Portal</a>.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 rounded-3" style="background: rgba(14, 26, 61, 0.6); border: 1px solid var(--border-subtle);">
                <h4 class="h6 text-white mb-2">⏱️ Payment Verification Time</h4>
                <p class="text-secondary mb-0" style="font-size: 0.82rem;">
                    Transfers are checked against official MFS merchant statements. Standard turnaround is 15–60 minutes.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
