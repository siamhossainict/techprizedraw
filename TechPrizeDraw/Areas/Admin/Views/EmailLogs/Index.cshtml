@model List<TechPrizeDraw.Models.Entities.EmailLog>
@{
    ViewData["Title"] = "Email Delivery Logs";
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
    string search = ViewBag.Search as string ?? string.Empty;
}

<div class="mb-4">
    <h1 class="text-white mb-1" style="font-size: 1.8rem;">Email Dispatch & Delivery Registry</h1>
    <p class="text-secondary mb-0" style="font-size: 0.85rem;">
        Detailed logs of order acknowledgments and official ticket email deliveries.
    </p>
</div>

<!-- Search Bar -->
<div class="card-tech p-3 mb-4">
    <form method="get" action="/Admin/EmailLogs" class="row g-2">
        <div class="col-md-9">
            <input type="text" name="search" value="@search" class="form-control form-tech w-100" placeholder="Filter by recipient email, subject, or template name..." />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-tech-gold w-100">Filter Email Logs</button>
        </div>
    </form>
</div>

<!-- Email Logs Table -->
<div class="card-tech p-4">
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table-tech" style="font-size: 0.85rem;">
                <thead>
                    <tr>
                        <th>Date (UTC)</th>
                        <th>Recipient Email</th>
                        <th>Template</th>
                        <th>Subject</th>
                        <th>Status</th>
                        <th>Error / Note</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td class="text-secondary font-monospace">@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td><strong class="text-white">@log.RecipientEmail</strong></td>
                            <td><span class="badge bg-dark border border-secondary text-info">@log.TemplateName</span></td>
                            <td class="text-secondary" style="max-width: 250px;">@log.Subject</td>
                            <td>
                                <span class="badge @(log.Status == EmailStatus.Sent ? "bg-success" : log.Status == EmailStatus.Failed ? "bg-danger" : "bg-warning text-dark")">
                                    @log.Status
                                </span>
                            </td>
                            <td class="text-muted" style="max-width: 200px; font-size: 0.8rem;">
                                @(log.ErrorMessage ?? "None")
                            </td>
                            <td class="text-end">
                                @if (log.TicketId.HasValue)
                                {
                                    <form asp-area="Admin" asp-controller="EmailLogs" asp-action="Resend" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="ticketId" value="@log.TicketId.Value" />
                                        <button type="submit" class="btn btn-sm btn-outline-info" title="Resend email to recipient">
                                            Resend
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top border-secondary border-opacity-25">
                <span class="text-secondary" style="font-size: 0.85rem;">Page @(page) of @(totalPages) (@totalItems logs)</span>
                <div class="d-flex gap-1">
                    @if (page > 1)
                    {
                        <a href="@Url.Action("Index", new { page = page - 1, search })" class="btn btn-sm btn-outline-secondary">Previous</a>
                    }
                    @if (page < totalPages)
                    {
                        <a href="@Url.Action("Index", new { page = page + 1, search })" class="btn btn-sm btn-outline-secondary">Next</a>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-4 text-secondary">
            No email dispatch logs found.
        </div>
    }
</div>
