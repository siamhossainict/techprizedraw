<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — " : "")Admin Executive Portal | TECH Draw</title>

    <!-- Google Fonts: Inter & Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Poppins:wght@600;700;800;900&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <!-- Custom Theme & Site CSS -->
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        html {
            overflow-y: scroll !important;
            overflow-x: hidden !important;
            scroll-behavior: smooth;
            scrollbar-width: thin;
            scrollbar-color: #00D2FF #060B18;
        }

        body {
            overflow-x: hidden !important;
            overflow-y: visible !important;
            min-height: 100vh;
        }

        ::-webkit-scrollbar {
            width: 12px !important;
            height: 12px !important;
            display: block !important;
        }

        ::-webkit-scrollbar-track {
            background: #060B18 !important;
            border-left: 1px solid rgba(255, 255, 255, 0.08) !important;
        }

        ::-webkit-scrollbar-thumb {
            background: linear-gradient(180deg, #00D2FF 0%, #0A58CA 100%) !important;
            border-radius: 6px !important;
            border: 2px solid #060B18 !important;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(180deg, #F5C842 0%, #E5A93C 100%) !important;
        }
    </style>
</head>
<body class="atmospheric-bg">

    <div class="container-fluid p-0">
        <div class="row g-0">
            <!-- Admin Sidebar Navigation -->
            <div class="col-lg-2 col-md-3 admin-sidebar d-flex flex-column justify-content-between">
                <div>
                    <!-- Brand -->
                    <div class="mb-4 px-2">
                        <a href="/Admin/Dashboard" class="tech-brand text-decoration-none">
                            <span style="color: #00D2FF;">⚡</span> TECH <span class="badge-tech">ADMIN</span>
                        </a>
                        <small class="text-secondary d-block mt-1" style="font-size: 0.75rem;">Operations Console</small>
                    </div>

                    <!-- Navigation Items -->
                    <nav class="d-flex flex-column">
                        <a href="/Admin/Dashboard" class="admin-nav-item">
                            <span>📊</span> Dashboard
                        </a>
                        <a href="/Admin/PaymentVerification" class="admin-nav-item d-flex justify-content-between align-items-center">
                            <span><span>💳</span> Payment Verification</span>
                        </a>
                        <a href="/Admin/Orders" class="admin-nav-item">
                            <span>📦</span> Orders
                        </a>
                        <a href="/Admin/Tickets" class="admin-nav-item">
                            <span>🎟️</span> Tickets
                        </a>
                        <a href="/Admin/PaymentMethods" class="admin-nav-item">
                            <span>📱</span> Payment Numbers
                        </a>
                        <a href="/Admin/Prizes" class="admin-nav-item">
                            <span>🎁</span> Prize Showcase
                        </a>
                        @if (User.IsInRole("SuperAdmin"))
                        {
                            <a href="/Admin/Campaign" class="admin-nav-item">
                                <span>⚙️</span> Campaign Settings
                            </a>
                            <a href="/Admin/Draw" class="admin-nav-item">
                                <span>🎲</span> Conduct Draw
                            </a>
                        }
                        <a href="/Admin/EmailLogs" class="admin-nav-item">
                            <span>✉️</span> Email Logs
                        </a>
                        <a href="/Admin/AuditLogs" class="admin-nav-item">
                            <span>📜</span> Audit Logs
                        </a>
                    </nav>
                </div>

                <!-- User Profile & Logout -->
                <div class="pt-3 border-top border-secondary border-opacity-25 px-2">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div>
                            <strong class="text-white d-block" style="font-size: 0.85rem;">@User.Identity?.Name</strong>
                            <span class="badge bg-secondary text-info" style="font-size: 0.7rem;">Staff User</span>
                        </div>
                    </div>
                    <form asp-area="Admin" asp-controller="Account" asp-action="Logout" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                            Logout
                        </button>
                    </form>
                    <a href="/" class="btn btn-link btn-sm text-secondary w-100 text-decoration-none mt-1" style="font-size: 0.8rem;">
                        ← View Public Site
                    </a>
                </div>
            </div>

            <!-- Admin Main Content Area -->
            <div class="col-lg-10 col-md-9 admin-content">
                <!-- Alerts / Notifications -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert" style="background: rgba(16, 185, 129, 0.15); border: 1px solid #10B981; color: #10B981;">
                        <strong>Success:</strong> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert" style="background: rgba(239, 68, 68, 0.15); border: 1px solid #EF4444; color: #EF4444;">
                        <strong>Notice:</strong> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
