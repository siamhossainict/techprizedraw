@model TechPrizeDraw.Models.ViewModels.LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Staff Authentication";
    ViewData["HideFooter"] = true;
}

<div class="container py-5" style="max-width: 480px;">
    <div class="card-tech p-4 p-md-5">
        <div class="text-center mb-4">
            <span style="font-size: 2.5rem; color: #00D2FF;">⚡</span>
            <h2 class="text-white mt-2" style="font-size: 1.8rem;">Staff Portal</h2>
            <p class="text-secondary" style="font-size: 0.85rem;">Authorized Personnel Only</p>
        </div>

        <form asp-area="Admin" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" method="post" autocomplete="off">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert" style="font-size: 0.85rem;"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label-tech">Staff Email</label>
                <input asp-for="Email" class="form-control form-tech w-100" placeholder="Enter your email" autocomplete="username" autofocus />
                <span asp-validation-for="Email" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label-tech">Password</label>
                <input asp-for="Password" class="form-control form-tech w-100" placeholder="Enter your password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger" style="font-size: 0.8rem;"></span>
            </div>

            <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="RememberMe" style="accent-color: var(--accent-gold);" />
                <label class="form-check-label text-secondary" for="RememberMe" style="font-size: 0.85rem;">
                    Remember session on this device
                </label>
            </div>

            <button type="submit" class="btn-tech-gold w-100 py-2" style="font-size: 1rem;">
                Authenticate & Access Dashboard
            </button>
        </form>

    </div>
</div>
