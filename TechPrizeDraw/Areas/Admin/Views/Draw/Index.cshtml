@{
    ViewData["Title"] = "Cryptographic Prize Draw Console";
    var eligibility = ViewBag.Eligibility as TechPrizeDraw.Models.DTOs.DrawEligibilityDto;
    var finalized = ViewBag.FinalizedResult as TechPrizeDraw.Models.DTOs.DrawResultDto;
}

<div class="mb-4">
    <h1 class="text-white" style="font-size: 1.8rem;">Official Prize Draw Console</h1>
    <p class="text-secondary mb-0" style="font-size: 0.85rem;">
        Cryptographic hardware-grade pseudorandom selection engine. Requires SuperAdmin authorization.
    </p>
</div>

@if (finalized != null)
{
    <!-- Finalized Immutable Results -->
    <div class="card-tech card-tech-gold p-4 mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="badge bg-success px-3 py-1" style="font-size: 0.85rem;">DRAW COMPLETED & IMMUTABLE</span>
            <span class="text-secondary" style="font-size: 0.85rem;">Executed on @finalized.DrawDateTime.ToString("yyyy-MM-dd HH:mm:ss") UTC</span>
        </div>

        <h3 class="text-white mb-3">Official Winning Entries</h3>

        <div class="table-responsive">
            <table class="table-tech">
                <thead>
                    <tr>
                        <th>Podium Position</th>
                        <th>Prize Name</th>
                        <th>Winning Ticket</th>
                        <th>Selected Participant</th>
                        <th>Timestamp</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var w in finalized.Winners.OrderBy(w => w.Position))
                    {
                        <tr>
                            <td>
                                <strong style="color: var(--accent-gold); font-size: 1.1rem;">
                                    @(w.Position == 1 ? "🥇 1st Prize" : w.Position == 2 ? "🥈 2nd Prize" : "🥉 3rd Prize")
                                </strong>
                            </td>
                            <td class="text-white">@w.PrizeName</td>
                            <td>
                                <span class="badge bg-dark border border-warning text-warning font-monospace" style="font-size: 1.1rem; padding: 0.4rem 0.8rem;">
                                    @w.TicketNumber
                                </span>
                            </td>
                            <td class="text-white">@w.CustomerMaskedName</td>
                            <td class="text-secondary" style="font-size: 0.85rem;">@w.SelectedAt.ToString("HH:mm:ss") UTC</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-4 pt-3 border-top border-secondary border-opacity-25 text-secondary" style="font-size: 0.85rem;">
            Executed By: <strong class="text-white">@finalized.ExecutedBy</strong> &bull; Total Valid Pool: <strong>@finalized.EligibleTicketsCount</strong> &bull; Method: <strong>@finalized.DrawMethod</strong>
        </div>
    </div>
}
else if (eligibility != null)
{
    <div class="card-tech p-4 mb-4" style="max-width: 800px;">
        <h4 class="text-white mb-3">Pre-Draw Verification</h4>

        <div class="row g-3 mb-4">
            <div class="col-sm-6">
                <div class="p-3 rounded" style="background: var(--bg-surface-elevated);">
                    <span class="text-secondary d-block" style="font-size: 0.75rem; text-transform: uppercase;">Eligible Valid Tickets</span>
                    <div style="font-size: 2rem; font-weight: 800; color: #10B981;">
                        @eligibility.EligibleValidTicketsCount.ToString("N0")
                    </div>
                    <small class="text-muted">Tickets in Valid status</small>
                </div>
            </div>

            <div class="col-sm-6">
                <div class="p-3 rounded" style="background: var(--bg-surface-elevated);">
                    <span class="text-secondary d-block" style="font-size: 0.75rem; text-transform: uppercase;">Active Prize Tiers</span>
                    <div style="font-size: 2rem; font-weight: 800; color: var(--accent-gold);">
                        @eligibility.ActivePrizesCount
                    </div>
                    <small class="text-muted">1st, 2nd, and 3rd Prizes</small>
                </div>
            </div>
        </div>

        @if (!eligibility.CanExecuteDraw)
        {
            <div class="alert alert-warning mb-4" style="background: rgba(245, 158, 11, 0.15); border: 1px solid #F59E0B; color: #F59E0B;">
                <strong>Draw Blocked:</strong> @eligibility.Reason
            </div>
        }
        else
        {
            <div class="alert alert-info mb-4" style="background: rgba(0, 210, 255, 0.1); border: 1px solid #00D2FF; color: #00D2FF;">
                <strong>Ready for Execution:</strong> All prerequisites met. Cryptographic random selection is ready to execute across @eligibility.EligibleValidTicketsCount eligible valid tickets.
            </div>

            <form asp-area="Admin" asp-controller="Draw" asp-action="Execute" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="form-label-tech">Operator Draw Notes (Permanent Audit Trail)</label>
                    <textarea name="notes" class="form-control form-tech w-100" rows="2" placeholder="e.g. Official draw conducted in presence of executive committee."></textarea>
                </div>

                <button type="submit" class="btn btn-tech-gold btn-lg w-100 py-3" onclick="return confirm('CRITICAL: Executing the draw will permanently and immutably select winners using cryptographic randomness. Are you sure you wish to finalize?');">
                    🎲 EXECUTE OFFICIAL CRYPTOGRAPHIC DRAW
                </button>
            </form>
        }
    </div>
}
