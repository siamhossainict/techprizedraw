@model List<TechPrizeDraw.Models.Entities.Prize>
@{
    ViewData["Title"] = "Prize Showcase Management";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="text-white mb-1" style="font-size: 1.8rem;">Prize Showcase</h1>
        <p class="text-secondary mb-0" style="font-size: 0.85rem;">
            Manage 1st, 2nd, and 3rd technology prize titles, specifications, and images.
        </p>
    </div>
</div>

<div class="row g-4">
    @foreach (var prize in Model.OrderBy(p => p.Position))
    {
        <div class="col-md-4">
            <div class="card-tech p-4 h-100 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge @(prize.Position == 1 ? "bg-warning text-dark" : prize.Position == 2 ? "bg-secondary text-white" : "bg-danger text-white") px-3 py-1" style="font-weight: 800;">
                        @prize.Title
                    </span>
                    <span class="badge @(prize.IsActive ? "bg-success" : "bg-secondary")">
                        @(prize.IsActive ? "Active" : "Disabled")
                    </span>
                </div>

                <div class="text-center my-3">
                    <img src="@prize.ImageUrl" alt="@prize.Name" style="max-height: 120px; object-fit: contain;" />
                </div>

                <h4 class="text-white mb-1" style="font-size: 1.25rem;">@prize.Name</h4>
                <p class="text-secondary mb-3 flex-grow-1" style="font-size: 0.85rem;">@prize.Description</p>

                @if (!string.IsNullOrWhiteSpace(prize.Specifications))
                {
                    <div class="p-2 rounded mb-3" style="background: var(--bg-surface-elevated); font-size: 0.8rem; color: var(--accent-cyan);">
                        @prize.Specifications
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary border-opacity-25 mt-auto">
                    <span style="color: var(--accent-gold); font-weight: 700;">৳@prize.EstimatedValue.ToString("N0") BDT</span>
                    <a href="/Admin/Prizes/Edit/@prize.Id" class="btn btn-outline-info btn-sm">
                        Edit Prize
                    </a>
                </div>
            </div>
        </div>
    }
</div>
